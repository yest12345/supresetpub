# Database Connection String
# Format: mysql://用户名:密码@主机:端口/数据库名
# 本地开发（项目脚本 npm run db:local 使用 3307 端口）
DATABASE_URL="mysql://root@127.0.0.1:3307/supreset"

# Node Environment
NODE_ENV="development"

# JWT Secret Key (用于加密 JWT Token)
# ⚠️ 生产环境必须使用强随机字符串！可使用: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
